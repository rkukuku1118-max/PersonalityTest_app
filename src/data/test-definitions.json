    "id": "60",
    "label": "60問版",
    "source": {
      "questions": "src/data/test-definitions.json",
      "convertedFrom": "ref/60/Japanese_self60.doc",
      "scoring": "ref/60/ScoringKeys_60.pdf",
      "descriptives": "ref/60/descriptives_60.pdf"
    },
    "responseOptions": [
      "あてはまらない（そうではない）",
      "どちらかといえば，あてはまらない",
      "どちらともいえない",
      "どちらかといえば，あてはまる",
      "あてはまる（そうである）"
    ],
    "questions": [
      {
        "id": 1,
        "text": "美術館に行くと，とても退屈してしまう。"
      },
      {
        "id": 2,
        "text": "直前になって慌てないよう、前もって計画を立て、準備をする。"
      },
      {
        "id": 3,
        "text": "ひどく不当な扱いを受けた相手に対しても、恨みを抱くことはめったにない。"
      },
      {
        "id": 4,
        "text": "全体として、自分自身にほどよく満足している。"
      },
      {
        "id": 5,
        "text": "悪天候の中を移動しなければならないとしたら、怖いと感じる。"
      },
      {
        "id": 6,
        "text": "昇給や昇進につながると思っても、仕事でお世辞を使おうとは思わない。"
      },
      {
        "id": 7,
        "text": "他の国の歴史や政治について学ぶことに興味がある。"
      },
      {
        "id": 8,
        "text": "目標を達成しようとするときは、しばしば自分をかなり追い込む。"
      },
      {
        "id": 9,
        "text": "人からときどき，他人に対して批判的すぎると言われる。"
      },
      {
        "id": 10,
        "text": "集団での話し合いでは，自分の意見を言うことはめったにない。"
      },
      {
        "id": 11,
        "text": "些細なことが気になり、心配せずにはいられないことがある。"
      },
      {
        "id": 12,
        "text": "もし決して捕まらないとわかっているのなら，私は1億円を盗もうと思う。"
      },
      {
        "id": 13,
        "text": "小説を書く、曲を作る、絵を描くなど、芸術作品を創作することを楽しめる。"
      },
      {
        "id": 14,
        "text": "何かの仕事をするとき，細かい点にはあまり注意を払わない。"
      },
      {
        "id": 15,
        "text": "ときどき人から，私は頑固すぎると言われる。"
      },
      {
        "id": 16,
        "text": "一人で進める仕事より、人と活発に関わる仕事のほうが好きだ。"
      },
      {
        "id": 17,
        "text": "つらい経験をしたときは、誰かに慰めてもらう必要がある。"
      },
      {
        "id": 18,
        "text": "大金を持つことは，自分にとって特に重要なことではない。"
      },
      {
        "id": 19,
        "text": "斬新で慣習にとらわれない考えに目を向けるのは、時間の無駄だと思う。"
      },
      {
        "id": 20,
        "text": "じっくり考えるよりも、その場の気分で物事を決める。"
      },
      {
        "id": 21,
        "text": "周りの人から、短気な人だと思われている。"
      },
      {
        "id": 22,
        "text": "たいていは，元気で楽天的である。"
      },
      {
        "id": 23,
        "text": "他の人が泣いているのを見ると、自分も泣きたくなる。"
      },
      {
        "id": 24,
        "text": "私は，平均的な人間よりも，尊重される権利があると思う。"
      },
      {
        "id": 25,
        "text": "もし機会があれば，クラシック音楽の演奏会に行きたい。"
      },
      {
        "id": 26,
        "text": "仕事中、自分の段取りが悪いために困ることがある。"
      },
      {
        "id": 27,
        "text": "自分にひどいことをした人に対しては、「許して忘れる」という姿勢でいる。"
      },
      {
        "id": 28,
        "text": "自分は人から好かれていないと感じる。"
      },
      {
        "id": 29,
        "text": "身体的な危険に対して、非常に強い恐怖を感じる。"
      },
      {
        "id": 30,
        "text": "誰かから何かを得たいときは、その人のひどくつまらない冗談にも笑う。"
      },
      {
        "id": 31,
        "text": "百科事典を眺めたり読んだりするのを、楽しいと思ったことはない。"
      },
      {
        "id": 32,
        "text": "必要とされる最低限の仕事しかしない。"
      },
      {
        "id": 33,
        "text": "人を判断するときは、甘めに見る傾向がある。"
      },
      {
        "id": 34,
        "text": "人づきあいの場では、たいてい自分から最初に行動を起こす。"
      },
      {
        "id": 35,
        "text": "他の人ほどは心配性ではない。"
      },
      {
        "id": 36,
        "text": "たとえどんなに大金でも，賄賂は決して受け取らない。"
      },
      {
        "id": 37,
        "text": "想像力が豊かだと、人からよく言われる。"
      },
      {
        "id": 38,
        "text": "たとえ時間がかかっても，自分の仕事ではいつも正確であるようにしている。"
      },
      {
        "id": 39,
        "text": "人に反対されても、自分の意見についてはかなり柔軟でいられることが多い。"
      },
      {
        "id": 40,
        "text": "新しい場所に行くと、いつも最初に友達を作る。"
      },
      {
        "id": 41,
        "text": "誰かに精神的に支えてもらわなくても、困難な状況に対処できる。"
      },
      {
        "id": 42,
        "text": "高価なぜいたく品を持つことに、大きな喜びを感じると思う。"
      },
      {
        "id": 43,
        "text": "型にはまらない見方をする人が好きだ。"
      },
      {
        "id": 44,
        "text": "行動する前に考えないため、たくさんの失敗をしてしまう。"
      },
      {
        "id": 45,
        "text": "たいていの人は，私よりもすぐに怒り出す。"
      },
      {
        "id": 46,
        "text": "たいていの人は，私よりも陽気で活発である。"
      },
      {
        "id": 47,
        "text": "親しい人が長い間遠くへ行ってしまうときは、強く感情を揺さぶられる。"
      },
      {
        "id": 48,
        "text": "自分が地位の高い重要な人物だと、人に知ってほしい。"
      },
      {
        "id": 49,
        "text": "自分のことを，芸術家タイプとか，創造的なタイプであるとは思わない。"
      },
      {
        "id": 50,
        "text": "人からしばしば完全主義者だと言われる。"
      },
      {
        "id": 51,
        "text": "人がたくさん間違えても、否定的なことはめったに言わない。"
      },
      {
        "id": 52,
        "text": "自分には価値がないと感じることがある。"
      },
      {
        "id": 53,
        "text": "緊急事態でも、パニックになりそうにはない。"
      },
      {
        "id": 54,
        "text": "頼みを聞いてもらうためだけに、その人を好きなふりはしない。"
      },
      {
        "id": 55,
        "text": "哲学について話し合うのは退屈だ。"
      },
      {
        "id": 56,
        "text": "計画に従うより、そのとき思いついたことをするほうが好きだ。"
      },
      {
        "id": 57,
        "text": "間違っていると人から言われると、まず反論したくなる。"
      },
      {
        "id": 58,
        "text": "グループにいるとき、そのグループを代表して話すことがよくある。"
      },
      {
        "id": 59,
        "text": "ほとんどの人が感傷的になるような場面でも、感情的にならずにいられる。"
      },
      {
        "id": 60,
        "text": "絶対に見つからないと分かっていれば、偽札を使いたくなる。"
      }
    ],
